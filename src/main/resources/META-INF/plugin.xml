<idea-plugin>
    <id>com.github.ycyz.starrocks.support</id>
    <name>StarRocks Support</name>
    <vendor>ycyz</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.database</depends>

    <description><![CDATA[
        <p>StarRocks Support provides a dedicated StarRocks SQL dialect and database integration for DataGrip and other JetBrains IDEs with Database Tools.</p>

        <h3>Features</h3>
        <ul>
            <li>StarRocks SQL parsing and syntax highlighting.</li>
            <li>Code completion for StarRocks keywords, types, functions, snippets, and table properties.</li>
            <li>Platform-based SQL formatting for the StarRocks dialect.</li>
            <li>Dedicated StarRocks DBMS and data source integration.</li>
            <li>JDBC metadata, StarRocks type system, object resolution, and native <code>SHOW CREATE</code> support.</li>
            <li>Syntax coverage aligned with the StarRocks 4.1 documentation baseline.</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <ul>
            <li>Fixed false unresolved-symbol warnings for partition names in <code>INSERT OVERWRITE ... PARTITION (...)</code>.</li>
            <li>Resolved tables and columns declared by an earlier <code>CREATE TABLE</code> statement in the same SQL file, including quoted identifiers.</li>
            <li>Added 52 documented StarRocks built-in functions to platform completion and symbol resolution, including <code>REGEXP_EXTRACT_ALL</code>, <code>REGEXP_COUNT</code>, and <code>REGEXP_SPLIT</code>.</li>
            <li>Fixed formatter alignment for SELECT aliases following arithmetic expressions and for multiline <code>GROUP BY</code> fields.</li>
            <li>Fixed unwanted spaces in <code>CAST(...)</code>, <code>ARRAY&lt;...&gt;</code>, <code>MAP&lt;...&gt;</code>, and <code>STRUCT&lt;...&gt;</code> by using the platform SQL PSI and formatter blocks.</li>
            <li>Recognized named <code>STRUCT</code> members as field definitions, preventing unresolved-symbol warnings and preserving identifier case during formatting.</li>
        </ul>
    ]]></change-notes>

    <extensions defaultExtensionNs="com.intellij">
        <sql.dialect dbms="STARROCKS" implementationClass="com.github.ycyz.starrocks.datagrip.dialect.StarRocksDialect"/>
        <sql.dialectCodeStyleProvider implementation="com.github.ycyz.starrocks.datagrip.format.StarRocksCodeStyleProvider"/>
        <lang.parserDefinition language="StarRocks" implementationClass="com.github.ycyz.starrocks.datagrip.lang.StarRocksParserDefinition"/>
        <lang.syntaxHighlighterFactory language="StarRocks" implementationClass="com.github.ycyz.starrocks.datagrip.highlight.StarRocksSyntaxHighlighterFactory"/>
        <sql.formatterHelper language="StarRocks" implementationClass="com.github.ycyz.starrocks.datagrip.format.StarRocksFormatterHelper"/>
        <completion.contributor language="StarRocks" implementationClass="com.github.ycyz.starrocks.datagrip.completion.StarRocksCompletionContributor"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.database">
        <dbms id="STARROCKS" instance="com.github.ycyz.starrocks.datagrip.database.StarRocksDbms.INSTANCE"/>
        <dialect dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.GenericDialect"/>
        <modelFacade dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.model.GenericModelFacade"/>
        <introspector dbms="STARROCKS" implementationClass="com.intellij.database.dialects.base.introspector.jdbc.JdbcIntrospector$Factory"/>
        <jdbcMetadataWrapper dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.introspector.jdbc.GenericMetadataWrapper$Factory"/>
        <jdbcSourceLoader dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.introspector.jdbc.GenericJdbcSourceLoader"/>
        <scriptGenerator dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.generator.GenericScriptGenerator"/>
        <namingService dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.naming.GenericNamingService$Provider"/>
        <sqlObjectBuilder dbms="STARROCKS" implementationClass="com.intellij.database.dialects.sql92.Sql92ObjectBuilder"/>
        <definitionProvider dbms="STARROCKS" implementationClass="com.github.ycyz.starrocks.datagrip.database.StarRocksDefinitionProvider"/>
        <typeSystem dbms="STARROCKS" implementationClass="com.github.ycyz.starrocks.datagrip.database.StarRocksTypeSystem"/>
        <executionEnvironmentHelper dbms="STARROCKS" implementationClass="com.intellij.database.dialects.base.BaseExecutionEnvironmentHelper"/>
        <dmlHelper dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.GenericDmlHelper"/>
        <gridHelper dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.GenericGridHelper"/>
        <hookUpHelper dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.GenericHookUpHelper"/>
        <errorHandler dbms="STARROCKS" implementationClass="com.intellij.database.dialects.generic.GenericDatabaseErrorHandler"/>
        <jdbcHelper dbms="STARROCKS" implementationClass="com.intellij.database.remote.jdbc.helpers.GenericJdbcHelper"/>
        <!--suppress PluginXmlValidity -->
        <driversConfig config="databaseDrivers/starrocks-drivers.xml"/>
    </extensions>
</idea-plugin>
