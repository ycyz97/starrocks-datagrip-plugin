{
  parserClass="com.github.ycyz.starrocks.datagrip.lang.StarRocksGeneratedParser"
  parserUtilClass="com.github.ycyz.starrocks.datagrip.lang.StarRocksParserUtil"
  elementTypeHolderClass="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementTypes"
  tokenTypeClass="com.intellij.sql.psi.SqlTokens"
  tokenTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.token"
  elementTypeFactory(".*")="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  psiClassPrefix="StarRocks"
  psiImplClassSuffix="Impl"
  psiPackage="com.github.ycyz.starrocks.datagrip.lang.psi"
  psiImplPackage="com.github.ycyz.starrocks.datagrip.lang.psi.impl"
}

script ::= statement (statement_separator statement)* statement_separator? <<eof>>
private statement_separator ::= ";"

statement ::= dml_statement | ddl_statement | other_statement {
  pin=1
  recoverWhile=statement_recover
}

private statement_recover ::= !(";" | ddl_statement_start | dml_statement_start | other_statement_start)
private ddl_statement_start ::= "CREATE" | "ALTER" | "DROP" | "TRUNCATE" | "REFRESH" | "GRANT" | "REVOKE"
private dml_statement_start ::= "SELECT" | "WITH" | "VALUES" | "INSERT" | "UPDATE" | "DELETE" | "MERGE"
private other_statement_start ::= "SHOW" | "ADMIN" | "ANALYZE" | "SET" | "UNSET" | "KILL" | "SYNC" | "CALL" | "BEGIN" | "START" | "COMMIT" | "ROLLBACK" | "USE" | "EXPLAIN" | "DESC" | "DESCRIBE" | "LOAD" | "CANCEL" | "SUBMIT" | "EXPORT" | "BACKUP" | "RESTORE" | "RECOVER"

ddl_statement ::= create_statement | alter_statement | drop_statement | truncate_table_statement | refresh_materialized_view_statement | grant_statement | revoke_statement

create_statement ::= create_materialized_view_guarded
  | create_view_guarded
  | create_table_guarded
  | create_catalog_guarded
  | create_resource_guarded
  | create_routine_load_guarded
  | create_repository_guarded
  | create_principal_guarded
  | create_schema_guarded
  | create_index_guarded

private create_materialized_view_guarded ::= &create_materialized_view_start create_materialized_view_statement
private create_materialized_view_start ::= "CREATE" "MATERIALIZED" "VIEW"
private create_view_guarded ::= &create_view_start create_view_statement
private create_view_start ::= "CREATE" (("OR" "REPLACE")? "VIEW")
private create_table_guarded ::= &create_table_start create_table_statement
private create_table_start ::= "CREATE" ("TEMPORARY" | "EXTERNAL")? "TABLE"
private create_catalog_guarded ::= &create_catalog_start create_catalog_statement
private create_catalog_start ::= "CREATE" "EXTERNAL"? "CATALOG"
private create_resource_guarded ::= &create_resource_start create_resource_statement
private create_resource_start ::= "CREATE" "EXTERNAL"? "RESOURCE"
private create_routine_load_guarded ::= &("CREATE" "ROUTINE" "LOAD") create_routine_load_statement
private create_repository_guarded ::= &("CREATE" "REPOSITORY") create_repository_statement
private create_principal_guarded ::= &("CREATE" ("USER" | "ROLE")) create_principal_statement
private create_schema_guarded ::= &("CREATE" ("DATABASE" | "SCHEMA")) create_schema_statement
private create_index_guarded ::= &("CREATE" "BITMAP"? "INDEX") create_index_statement

create_table_statement ::= "CREATE" table_scope? "TABLE" if_not_exists? table_reference table_column_list? create_table_clause* as_select_clause? {
  elementType="SQL_CREATE_TABLE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

private table_scope ::= "TEMPORARY" | "EXTERNAL"
private if_not_exists ::= "IF" "NOT" "EXISTS"
private if_exists ::= "IF" "EXISTS"

create_table_clause ::= key_model_clause
  | partition_clause
  | distribution_clause
  | buckets_clause
  | comment_clause
  | properties_clause
  | order_by_clause

key_model_clause ::= key_model "KEY" key_column_list {
  pin=2
  recoverWhile=clause_recover
}
private key_model ::= "PRIMARY" | "DUPLICATE" | "UNIQUE" | "AGGREGATE"

partition_clause ::= "PARTITION" "BY" partition_expression {
  pin=2
  recoverWhile=clause_recover
}
partition_expression ::= function_call | parenthesized_value_expression | identifier_reference

distribution_clause ::= "DISTRIBUTED" "BY" distribution_expression buckets_clause? {
  pin=2
  recoverWhile=clause_recover
}
distribution_expression ::= "HASH" parenthesized_identifier_list | "RANDOM" | function_call

buckets_clause ::= "BUCKETS" numeric_literal {
  pin=1
  recoverWhile=clause_recover
}

comment_clause ::= "COMMENT" string_literal {
  pin=1
  recoverWhile=clause_recover
}

properties_clause ::= "PROPERTIES" property_list {
  pin=1
  recoverWhile=clause_recover
}
property_list ::= "(" property_pair ("," property_pair)* ","? ")"
property_pair ::= property_key "=" property_value
property_key ::= string_literal | identifier_reference
property_value ::= string_literal | numeric_literal | keyword_literal | identifier_reference

create_view_statement ::= "CREATE" ("OR" "REPLACE")? "VIEW" if_not_exists? view_reference view_column_list? comment_clause? as_select_clause {
  elementType="SQL_CREATE_VIEW_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

create_materialized_view_statement ::= "CREATE" "MATERIALIZED" "VIEW" if_not_exists? materialized_view_reference view_column_list? create_materialized_view_clause* as_select_clause {
  elementType="SQL_CREATE_MATERIALIZED_VIEW_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
create_materialized_view_clause ::= partition_clause | distribution_clause | buckets_clause | refresh_clause | comment_clause | properties_clause
private view_column_list ::= "(" view_column ("," view_column)* ","? ")"
private view_column ::= identifier_reference view_column_comment?
private view_column_comment ::= "COMMENT" string_literal
refresh_clause ::= "REFRESH" refresh_mode? {
  pin=1
  recoverWhile=clause_recover
}
private refresh_mode ::= "ASYNC" | "MANUAL" | "IMMEDIATE" | "DEFERRED"

as_select_clause ::= "AS" embedded_query_expression {
  pin=1
  recoverWhile=statement_recover
}

create_catalog_statement ::= "CREATE" "EXTERNAL"? "CATALOG" catalog_reference (properties_clause | comment_clause)* {
  elementType="SQL_CREATE_CATALOG_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

create_resource_statement ::= "CREATE" "EXTERNAL"? "RESOURCE" resource_reference properties_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_routine_load_statement ::= "CREATE" "ROUTINE" "LOAD" qualified_identifier "ON" table_reference routine_load_clause* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
routine_load_clause ::= columns_clause | properties_clause | from_kafka_clause
columns_clause ::= "COLUMNS" ("TERMINATED" "BY" string_literal)?
from_kafka_clause ::= "FROM" "KAFKA" property_list?

create_repository_statement ::= "CREATE" "REPOSITORY" identifier_reference "WITH" "BROKER" identifier_reference? repository_location_clause? properties_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_principal_statement ::= create_user_guarded | create_role_guarded
private create_user_guarded ::= &("CREATE" "USER") create_user_statement
private create_role_guarded ::= &("CREATE" "ROLE") create_role_statement
create_user_statement ::= "CREATE" "USER" security_principal principal_tail* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
create_role_statement ::= "CREATE" "ROLE" security_principal principal_tail* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
private principal_type ::= "USER" | "ROLE"
principal_tail ::= identified_by_clause | default_role_clause | properties_clause | set_principal_comment_clause
identified_by_clause ::= "IDENTIFIED" "BY" value_expression
default_role_clause ::= "DEFAULT" "ROLE" security_principal_list
private set_principal_comment_clause ::= "SET" "COMMENT" string_literal

create_schema_statement ::= "CREATE" ("DATABASE" | "SCHEMA") if_not_exists? schema_reference properties_clause? comment_clause? {
  elementType="SQL_CREATE_SCHEMA_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

create_index_statement ::= "CREATE" "BITMAP"? "INDEX" index_reference "ON" table_reference parenthesized_identifier_list ("USING" "BITMAP")? properties_clause? comment_clause? {
  elementType="SQL_CREATE_INDEX_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

alter_statement ::= alter_materialized_view_guarded
  | alter_table_guarded
  | alter_view_guarded
  | alter_catalog_guarded
  | alter_resource_guarded
  | alter_schema_guarded
  | alter_principal_guarded
  | alter_routine_load_guarded

private alter_materialized_view_guarded ::= &("ALTER" "MATERIALIZED" "VIEW") alter_materialized_view_statement
private alter_table_guarded ::= &("ALTER" "TABLE") alter_table_statement
private alter_view_guarded ::= &("ALTER" "VIEW") alter_view_statement
private alter_catalog_guarded ::= &("ALTER" "CATALOG") alter_catalog_statement
private alter_resource_guarded ::= &("ALTER" "RESOURCE") alter_resource_statement
private alter_schema_guarded ::= &("ALTER" ("DATABASE" | "SCHEMA")) alter_schema_statement
private alter_principal_guarded ::= &("ALTER" ("USER" | "ROLE")) alter_principal_statement
private alter_routine_load_guarded ::= &("ALTER" "ROUTINE" "LOAD") alter_routine_load_statement

alter_table_statement ::= "ALTER" "TABLE" if_exists? table_reference alter_table_action {
  elementType="SQL_ALTER_TABLE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
alter_table_action ::= add_column_action | modify_column_action | drop_column_action | rename_action | set_properties_action
add_column_action ::= "ADD" "COLUMN"? column_definition
modify_column_action ::= ("MODIFY" | "CHANGE" | "ALTER") "COLUMN"? column_definition
drop_column_action ::= "DROP" "COLUMN"? identifier_reference
rename_action ::= "RENAME" ("TO" identifier_reference)?
set_properties_action ::= "SET" properties_clause

alter_view_statement ::= "ALTER" "VIEW" view_reference as_select_clause {
  elementType="SQL_ALTER_VIEW_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_materialized_view_statement ::= "ALTER" "MATERIALIZED" "VIEW" materialized_view_reference materialized_view_status? refresh_clause? properties_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}
private materialized_view_status ::= "ACTIVE" | "INACTIVE" | "SUSPEND" | "RESUME"

alter_catalog_statement ::= "ALTER" "CATALOG" catalog_reference set_properties_action {
  elementType="SQL_ALTER_CATALOG_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_resource_statement ::= "ALTER" "RESOURCE" resource_reference set_properties_action {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_schema_statement ::= "ALTER" ("DATABASE" | "SCHEMA") schema_reference alter_schema_action {
  elementType="SQL_ALTER_SCHEMA_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_principal_statement ::= alter_user_guarded | alter_role_guarded
private alter_user_guarded ::= &("ALTER" "USER") alter_user_statement
private alter_role_guarded ::= &("ALTER" "ROLE") alter_role_statement
alter_user_statement ::= "ALTER" "USER" security_principal principal_tail* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
alter_role_statement ::= "ALTER" "ROLE" security_principal principal_tail* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

alter_routine_load_statement ::= "ALTER" "ROUTINE" "LOAD" identifier_reference routine_load_clause* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

drop_statement ::= drop_materialized_view_guarded
  | drop_table_guarded
  | drop_view_guarded
  | drop_catalog_guarded
  | drop_resource_guarded
  | drop_repository_guarded
  | drop_schema_guarded
  | drop_index_guarded
  | drop_principal_guarded

private drop_materialized_view_guarded ::= &("DROP" "MATERIALIZED" "VIEW") drop_materialized_view_statement
private drop_table_guarded ::= &("DROP" "TABLE") drop_table_statement
private drop_view_guarded ::= &("DROP" "VIEW") drop_view_statement
private drop_catalog_guarded ::= &("DROP" "CATALOG") drop_catalog_statement
private drop_resource_guarded ::= &("DROP" "RESOURCE") drop_resource_statement
private drop_repository_guarded ::= &("DROP" "REPOSITORY") drop_repository_statement
private drop_schema_guarded ::= &("DROP" ("DATABASE" | "SCHEMA")) drop_schema_statement
private drop_index_guarded ::= &("DROP" "INDEX") drop_index_statement
private drop_principal_guarded ::= &("DROP" ("USER" | "ROLE")) drop_principal_statement

drop_table_statement ::= "DROP" "TABLE" if_exists? table_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_view_statement ::= "DROP" "VIEW" if_exists? view_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_materialized_view_statement ::= "DROP" "MATERIALIZED" "VIEW" if_exists? materialized_view_reference {
  pin=3
  recoverWhile=statement_recover
}
drop_catalog_statement ::= "DROP" "CATALOG" if_exists? catalog_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_resource_statement ::= "DROP" "RESOURCE" if_exists? resource_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_repository_statement ::= "DROP" "REPOSITORY" if_exists? identifier_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_schema_statement ::= "DROP" ("DATABASE" | "SCHEMA") if_exists? schema_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_index_statement ::= "DROP" "INDEX" index_reference "ON" table_reference {
  pin=2
  recoverWhile=statement_recover
}
drop_principal_statement ::= drop_user_guarded | drop_role_guarded
private drop_user_guarded ::= &("DROP" "USER") drop_user_statement
private drop_role_guarded ::= &("DROP" "ROLE") drop_role_statement
drop_user_statement ::= "DROP" "USER" security_principal {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
drop_role_statement ::= "DROP" "ROLE" security_principal {
  pin=2
  recoverWhile=statement_recover
}

truncate_table_statement ::= "TRUNCATE" "TABLE" table_reference {
  elementType="SQL_TRUNCATE_TABLE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

refresh_materialized_view_statement ::= "REFRESH" "MATERIALIZED" "VIEW" materialized_view_reference ("PARTITION" parenthesized_value_expression)? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=statement_recover
}

grant_statement ::= "GRANT" privilege_list "ON" privilege_target "TO" security_principal_list with_grant_option_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

revoke_statement ::= "REVOKE" privilege_list "ON" privilege_target "FROM" security_principal_list {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
privilege_list ::= privilege_item ("," privilege_item)*
privilege_item ::= "*" | identifier_reference
privilege_target ::= ("TABLE" | "DATABASE" | "CATALOG" | "RESOURCE" | "SYSTEM")? qualified_identifier
security_principal_list ::= security_principal ("," security_principal)*
security_principal ::= principal_type? principal_name ("@" principal_name)?
private principal_name ::= identifier_reference | string_literal
with_grant_option_clause ::= "WITH" "GRANT" "OPTION"

dml_statement ::= insert_statement | update_statement | delete_statement | merge_statement | select_statement

select_statement ::= query_expression {
  elementType="SQL_SELECT_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

query_expression ::= query_body {
  elementType="SQL_QUERY_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
private repository_location_clause ::= "ON" "LOCATION" string_literal
private alter_schema_action ::= set_properties_action | "SET" "DATA" "QUOTA" numeric_literal identifier_reference?
private embedded_query_expression ::= query_body
private query_body ::= set_query_expression_guarded | with_query_expression_guarded | values_expression_guarded
private query_recover ::= !(";" | "," | ")" | "SELECT" | "WITH" | "VALUES" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS")
private set_query_expression_guarded ::= &"SELECT" set_query_expression
private with_query_expression_guarded ::= &"WITH" with_query_expression
private values_expression_guarded ::= &"VALUES" values_expression

with_query_expression ::= with_clause (set_query_expression_guarded | values_expression_guarded) {
  pin=1
  recoverWhile=query_recover
}
with_clause ::= "WITH" "RECURSIVE"? named_query_definition ("," named_query_definition)* {
  elementType="SQL_WITH_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
named_query_definition ::= identifier_reference cte_column_list? "AS" parenthesized_query_expression {
  elementType="SQL_NAMED_QUERY_DEFINITION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=3
  recoverWhile=query_recover
}
cte_column_list ::= "(" cte_column_name ("," cte_column_name)* ","? ")"
cte_column_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
parenthesized_query_expression ::= "(" query_body ")" {
  elementType="SQL_PARENTHESIZED_QUERY_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}

set_query_expression ::= simple_query_expression set_operation_clause* {
  pin=2
  recoverWhile=query_recover
}
set_operation_clause ::= set_operator simple_query_expression {
  pin=1
  recoverWhile=query_recover
}
set_operator ::= ("UNION" "ALL"?) | "INTERSECT" | "EXCEPT" | "MINUS"

simple_query_expression ::= select_clause from_clause_guarded? where_clause_guarded? group_by_clause_guarded? having_clause_guarded? qualify_clause_guarded? window_clause_guarded? order_by_clause_guarded? limit_clause_guarded? {
  pin=1
  recoverWhile=query_recover
}
private from_clause_guarded ::= &"FROM" from_clause
private where_clause_guarded ::= &"WHERE" where_clause
private group_by_clause_guarded ::= &"GROUP" group_by_clause
private having_clause_guarded ::= &"HAVING" having_clause
private qualify_clause_guarded ::= &"QUALIFY" qualify_clause
private window_clause_guarded ::= &"WINDOW" window_clause
private order_by_clause_guarded ::= &"ORDER" order_by_clause
private limit_clause_guarded ::= &"LIMIT" limit_clause
select_clause ::= "SELECT" select_modifier* select_item ("," select_item)* {
  elementType="SQL_SELECT_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=select_recover
}
private select_modifier ::= "ALL" | "DISTINCT"
private select_recover ::= !(";" | ")" | "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT")
select_item ::= select_all | value_expression select_alias_clause?
select_all ::= qualified_identifier "." "*" | "*"
private select_alias_clause ::= "AS" select_alias | !select_alias_boundary select_alias
private select_alias_boundary ::= "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "UNION" | "INTERSECT" | "EXCEPT" | "MINUS"
select_alias ::= identifier_reference {
  elementType="SELECT_ALIAS"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

from_clause ::= "FROM" table_expression ("," table_expression)* {
  elementType="SQL_FROM_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=from_recover
}
private from_recover ::= !(";" | ")" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT")
table_expression ::= table_factor join_expression_guarded* {
  elementType="SQL_TABLE_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private table_factor ::= table_reference table_alias_clause?
  | derived_query_table
  | table_function_call table_alias_clause?
  | parenthesized_join_table
private derived_query_table ::= &parenthesized_query_start parenthesized_query_expression table_alias_clause?
private parenthesized_query_start ::= "(" ("SELECT" | "WITH" | "VALUES")
private parenthesized_join_table ::= &parenthesized_join_start parenthesized_join_expression table_alias_clause?
private parenthesized_join_start ::= "(" !("SELECT" | "WITH" | "VALUES")
private join_expression_guarded ::= &join_operator_start join_expression
private join_operator_start ::= "JOIN" | "STRAIGHT_JOIN" | "INNER" | "LEFT" | "RIGHT" | "FULL" | "CROSS" | "NATURAL" | "SEMI" | "ANTI"
parenthesized_join_expression ::= "(" table_expression ")" {
  elementType="SQL_PARENTHESIZED_JOIN_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
join_expression ::= join_operator table_factor join_condition_clause? {
  elementType="SQL_JOIN_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=from_recover
}
join_operator ::= ("INNER" | "LEFT" "OUTER"? | "RIGHT" "OUTER"? | "FULL" "OUTER"? | "CROSS" | "NATURAL" | "SEMI" | "ANTI")? ("JOIN" | "STRAIGHT_JOIN")
join_condition_clause ::= "ON" value_expression | using_clause {
  elementType="SQL_JOIN_CONDITION_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
using_clause ::= "USING" parenthesized_identifier_list {
  elementType="SQL_USING_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
private table_alias_clause ::= "AS"? table_alias table_alias_column_list?
table_alias ::= identifier_reference {
  elementType="TABLE_ALIAS"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
table_alias_column_list ::= "(" table_alias_column_name ("," table_alias_column_name)* ","? ")"
table_alias_column_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
table_function_call ::= "UNNEST" "(" value_expression ")"

where_clause ::= "WHERE" value_expression {
  elementType="SQL_WHERE_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}
group_by_clause ::= "GROUP" "BY" grouping_item ("," grouping_item)* {
  elementType="SQL_GROUP_BY_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=query_recover
}
grouping_item ::= grouping_sets_clause | value_expression
grouping_sets_clause ::= ("GROUPING" "SETS" | "ROLLUP" | "CUBE") "(" grouping_set ("," grouping_set)* ")"
grouping_set ::= "(" (value_expression ("," value_expression)*)? ")" | value_expression
having_clause ::= "HAVING" value_expression {
  elementType="SQL_HAVING_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}
qualify_clause ::= "QUALIFY" qualify_expression {
  elementType="SQL_QUALIFY_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
}
qualify_expression ::= value_expression {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
window_clause ::= "WINDOW" window_definition ("," window_definition)* {
  elementType="SQL_WINDOW_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
window_definition ::= window_name "AS" "(" window_specification ")"
window_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
window_specification ::= partition_by_clause? order_by_clause? frame_clause?
partition_by_clause ::= "PARTITION" "BY" value_expression ("," value_expression)*
frame_clause ::= ("ROWS" | "RANGE" | "GROUPS") frame_extent
frame_extent ::= "BETWEEN" frame_bound "AND" frame_bound | frame_bound
frame_bound ::= "UNBOUNDED" ("PRECEDING" | "FOLLOWING") | "CURRENT" "ROW" | value_expression ("PRECEDING" | "FOLLOWING")
order_by_clause ::= "ORDER" "BY" ordering_item ("," ordering_item)* {
  elementType="SQL_ORDER_BY_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=query_recover
}
ordering_item ::= value_expression ("ASC" | "DESC")? ("NULLS" ("FIRST" | "LAST"))?
limit_clause ::= "LIMIT" limit_expression ("," limit_expression)? {
  elementType="SQL_LIMIT_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
limit_expression ::= value_expression {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

values_expression ::= values_clause order_by_clause? limit_clause?
values_clause ::= "VALUES" values_row ("," values_row)* {
  elementType="SQL_VALUES_EXPRESSION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=query_recover
}
values_row ::= "(" value_expression ("," value_expression)* ")"

insert_statement ::= "INSERT" ("INTO" | "OVERWRITE") "TABLE"? table_reference insert_column_list? (embedded_query_expression | values_clause) {
  elementType="SQL_INSERT_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
private insert_column_list ::= parenthesized_identifier_list
update_statement ::= "UPDATE" dml_target_table set_clause from_clause? where_clause? {
  elementType="SQL_UPDATE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
delete_statement ::= "DELETE" "FROM"? dml_target_table where_clause? {
  elementType="SQL_DELETE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
merge_statement ::= "MERGE" "INTO" dml_target_table merge_using_clause merge_on_clause merge_when_clause+ {
  elementType="SQL_MERGE_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
dml_target_table ::= table_reference table_alias_clause?
set_clause ::= "SET" set_assignment ("," set_assignment)* {
  elementType="SQL_SET_CLAUSE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=set_clause_recover
}
private set_clause_recover ::= !(";" | "FROM" | "WHERE" | "WHEN")
set_assignment ::= column_reference "=" value_expression
merge_using_clause ::= "USING" table_expression
merge_on_clause ::= "ON" value_expression
merge_when_clause ::= "WHEN" ("MATCHED" | "NOT" "MATCHED") ("THEN" ("UPDATE" set_clause | "DELETE" | "INSERT" insert_column_list? values_clause))

other_statement ::= show_statement
  | admin_statement
  | analyze_statement
  | set_password_guarded
  | set_statement
  | unset_statement
  | kill_statement
  | sync_statement
  | call_statement
  | transaction_statement
  | use_statement
  | explain_statement
  | describe_statement
  | load_statement
  | cancel_load_guarded
  | task_statement
  | export_guarded
  | backup_restore_statement

private set_password_guarded ::= &("SET" "PASSWORD") set_password_statement
private cancel_load_guarded ::= &("CANCEL" "LOAD") cancel_load_statement
private export_guarded ::= &(("EXPORT" "TABLE") | ("CANCEL" "EXPORT")) export_statement

show_statement ::= "SHOW" show_target show_from_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
show_target ::= "DATABASES" | "SCHEMAS" | "TABLES" | "PARTITIONS" | "VARIABLES" | "ROLES" | "USERS" | "FUNCTIONS" | "GRANTS" | "CATALOGS" | "RESOURCES" | "MATERIALIZED" "VIEWS" | "ANALYZE" "STATUS" | "STATS" "META" | "BACKUP" | "RESTORE" | "CREATE" show_create_target | "PROC" value_expression?
show_from_clause ::= ("FROM" | "IN") qualified_identifier
show_create_target ::= ("TABLE" table_reference) | ("VIEW" view_reference) | ("MATERIALIZED" "VIEW" materialized_view_reference) | ("CATALOG" catalog_reference)

admin_statement ::= "ADMIN" "SHOW" ("FRONTEND" | "FRONTENDS" | "BACKEND" | "BACKENDS" | "BROKER" | "BROKERS") ("CONFIG" | "STATUS")? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}

analyze_statement ::= "ANALYZE" ("FULL" | "SAMPLE")? analyze_target analyze_histogram_clause? properties_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
analyze_target ::= "TABLE" table_reference analyze_column_list?
analyze_column_list ::= parenthesized_identifier_list
analyze_histogram_clause ::= "UPDATE" "HISTOGRAM" "ON" column_reference ("," column_reference)*

set_statement ::= "SET" set_assignment ("," set_assignment)* {
  elementType="SQL_SET_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
set_password_statement ::= "SET" "PASSWORD" ("FOR" security_principal)? "=" value_expression {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
unset_statement ::= "UNSET" "VARIABLE"? identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
kill_statement ::= "KILL" value_expression {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
sync_statement ::= "SYNC" {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
call_statement ::= "CALL" function_call {
  elementType="SQL_CALL_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
private transaction_statement ::= begin_statement | commit_statement | rollback_statement
begin_statement ::= "BEGIN" | "START" "TRANSACTION" {
  elementType="SQL_START_TRANSACTION_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
commit_statement ::= "COMMIT" {
  elementType="SQL_COMMIT_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
rollback_statement ::= "ROLLBACK" {
  elementType="SQL_ROLLBACK_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
use_statement ::= "USE" use_target {
  elementType="SQL_USE_SCHEMA_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
use_target ::= schema_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
explain_statement ::= "EXPLAIN" ("ANALYZE" | "VERBOSE" | "LOGICAL" | "COSTS")* query_expression {
  elementType="SQL_EXPLAIN_STATEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
describe_statement ::= ("DESC" | "DESCRIBE") "TABLE"? describe_target column_reference? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}
describe_target ::= table_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
load_statement ::= "LOAD" "LABEL" qualified_identifier "(" load_payload ")" ("WITH" "BROKER")? properties_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
private load_payload ::= "DATA" "INFILE" "(" string_literal ("," string_literal)* ")" "INTO" "TABLE" table_reference load_data_clause*
private load_data_clause ::= columns_clause | "FORMAT" "AS" string_literal
cancel_load_statement ::= "CANCEL" "LOAD" ("FROM" schema_reference)? where_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
task_statement ::= "SUBMIT" "TASK" identifier_reference "AS" (refresh_materialized_view_statement | query_expression) {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
export_statement ::= "EXPORT" "TABLE" table_reference "TO" string_literal properties_clause? | "CANCEL" "EXPORT" ("FROM" schema_reference)? where_clause? {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=2
  recoverWhile=statement_recover
}
backup_restore_statement ::= ("BACKUP" | "RESTORE") "SNAPSHOT" qualified_identifier ("TO" | "FROM") identifier_reference ("ON" "(" table_reference ("," table_reference)* ")")? properties_clause?
  | "RECOVER" ("TABLE" | "DATABASE" | "PARTITION" | "REPOSITORY")? identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=statement_recover
}

value_expression ::= or_expression
private expression_recover ::= !("," | ")" | ";" | "AS" | "FROM" | "WHERE" | "GROUP" | "HAVING" | "QUALIFY" | "WINDOW" | "ORDER" | "LIMIT" | "THEN" | "ELSE" | "END")
or_expression ::= and_expression ("OR" and_expression)*
and_expression ::= not_expression ("AND" not_expression)*
not_expression ::= "NOT"? comparison_expression
comparison_expression ::= additive_expression (comparison_operator additive_expression | "BETWEEN" additive_expression "AND" additive_expression | "NOT" "IN" in_list_or_subquery | "IN" in_list_or_subquery)*
private comparison_operator ::= "=" | "<" | ">" | "<=" | ">=" | "<>" | "!=" | "<=>" | "LIKE" | "REGEXP" | "RLIKE" | "IS" "NOT"?
additive_expression ::= multiplicative_expression (("+" | "-" | "||") multiplicative_expression)*
multiplicative_expression ::= unary_expression (("*" | "/" | "%" | "DIV" | "MOD") unary_expression)*
unary_expression ::= ("+" | "-" | "!" | "~" | "BINARY")* postfix_expression
postfix_expression ::= (cast_expression_guarded | case_expression_guarded | exists_expression_guarded | interval_expression_guarded | scalar_subquery_guarded | literal | function_call | parenthesized_value_expression | column_reference | typed_literal_expression) analytic_clause_guarded? array_access_tail* field_access_tail*
array_access_tail ::= "[" value_expression "]"
field_access_tail ::= "." identifier_reference
private cast_expression_guarded ::= &"CAST" cast_expression
private case_expression_guarded ::= &"CASE" case_expression
private exists_expression_guarded ::= &"EXISTS" exists_expression
private interval_expression_guarded ::= &"INTERVAL" interval_expression
private scalar_subquery_guarded ::= &parenthesized_query_start parenthesized_query_expression
cast_expression ::= "CAST" "(" value_expression "AS" cast_type ")" {
  pin=3
  recoverWhile=expression_recover
}
case_expression ::= "CASE" value_expression? case_when_clause+ case_else_clause? "END" {
  pin=1
  recoverWhile=expression_recover
}
case_when_clause ::= "WHEN" value_expression "THEN" value_expression
case_else_clause ::= "ELSE" value_expression
exists_expression ::= "EXISTS" "(" query_expression ")"
interval_expression ::= "INTERVAL" value_expression interval_unit
typed_literal_expression ::= typed_literal_prefix literal
function_call ::= function_name ("." function_name)* "(" function_argument_list? ")"
  {
    elementType="SQL_FUNCTION_CALL"
    elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  }
function_name ::= identifier_reference | function_keyword
function_keyword ::= <<parseFunctionKeyword>>
function_argument_list ::= ("DISTINCT" | "ALL")? value_expression ("," value_expression)* | "*"
parenthesized_value_expression ::= "(" value_expression ("," value_expression)* ")"
in_list_or_subquery ::= "(" (query_expression | value_expression ("," value_expression)*)? ")"
private analytic_clause_guarded ::= &"OVER" analytic_clause
analytic_clause ::= "OVER" (window_reference_name | "(" window_specification ")") {
  pin=1
}
window_reference_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

type_element ::= scalar_type type_parameters? | complex_type {
  elementType="SQL_TYPE_ELEMENT"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=type_recover
}
cast_type ::= type_element {
  pin=1
  recoverWhile=type_recover
}
private type_recover ::= !("," | ")" | ">" | "NULL" | "NOT" | "DEFAULT" | "COMMENT" | "AS")
scalar_type ::= "BOOLEAN" | "BOOL" | "TINYINT" | "SMALLINT" | "INT" | "INTEGER" | "BIGINT" | "LARGEINT" | "FLOAT" | "DOUBLE" | "DECIMAL" | "DECIMALV2" | "DECIMAL32" | "DECIMAL64" | "DECIMAL128" | "CHAR" | "VARCHAR" | "VARCHAR2" | "STRING" | "TEXT" | "DATE" | "DATETIME" | "TIME" | "TIMESTAMP" | "JSON" | "BITMAP" | "HLL"
type_parameters ::= "(" numeric_literal ("," numeric_literal)* ")"
complex_type ::= array_type | map_type | struct_type
array_type ::= "ARRAY" "<" type_element ">"
map_type ::= "MAP" "<" type_element "," type_element ">"
struct_type ::= "STRUCT" "<" struct_field ("," struct_field)* ">"
struct_field ::= identifier_reference ":"? type_element

table_column_list ::= "(" table_column_item ("," table_column_item)* ","? ")" {
  elementType="SQL_TABLE_ELEMENT_LIST"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
  pin=1
  recoverWhile=table_column_recover
}
private table_column_recover ::= !(")" | "," | ";" | "PRIMARY" | "DUPLICATE" | "UNIQUE" | "AGGREGATE" | "COMMENT" | "PARTITION" | "DISTRIBUTED" | "BUCKETS" | "PROPERTIES" | "ORDER" | "AS")
table_column_item ::= column_definition | table_constraint
column_definition ::= column_name type_element column_attribute* {
  elementType="SQL_COLUMN_DEFINITION"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_attribute ::= "NOT" "NULL" | "NULL" | "DEFAULT" value_expression | "COMMENT" string_literal | key_model "KEY" | "AUTO_INCREMENT"
table_constraint ::= ("PRIMARY" | "UNIQUE" | "DUPLICATE" | "AGGREGATE") "KEY" key_column_list
key_column_list ::= "(" key_column ("," key_column)* ","? ")"
key_column ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}

parenthesized_identifier_list ::= "(" identifier_reference ("," identifier_reference)* ","? ")"
qualified_identifier ::= identifier_reference ("." identifier_reference)*
identifier_reference ::= identifier | delimited_identifier
column_reference ::= qualified_column_prefix? column_reference_name
qualified_column_prefix ::= identifier_reference "." (identifier_reference ".")* {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_reference_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
column_name ::= identifier_reference {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
table_reference ::= table_reference_name {
  elementType="SQL_TABLE_REFERENCE"
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
table_reference_name ::= qualified_identifier {
  elementTypeFactory="com.github.ycyz.starrocks.datagrip.lang.StarRocksElementFactory.elementType"
}
view_reference ::= qualified_identifier
materialized_view_reference ::= qualified_identifier
schema_reference ::= qualified_identifier
catalog_reference ::= qualified_identifier
resource_reference ::= qualified_identifier
index_reference ::= qualified_identifier

literal ::= string_literal | numeric_literal | parameter_literal | keyword_literal
string_literal ::= SQL_STRING_TOKEN
numeric_literal ::= SQL_INTEGER_TOKEN | SQL_FLOAT_TOKEN
parameter_literal ::= STARROCKS_PARAMETER
keyword_literal ::= "TRUE" | "FALSE" | "NULL" | "CURRENT_DATE" | "CURRENT_TIME" | "CURRENT_TIMESTAMP" | "LOCALTIME" | "LOCALTIMESTAMP"
typed_literal_prefix ::= "DATE" | "DATETIME" | "TIME" | "TIMESTAMP"
interval_unit ::= "MICROSECOND" | "MILLISECOND" | "SECOND" | "SECONDS" | "MINUTE" | "MINUTES" | "HOUR" | "HOURS" | "DAY" | "DAYS" | "WEEK" | "MONTH" | "QUARTER" | "YEAR"

identifier ::= SQL_IDENT | <<parseOptionalKeyword>>
delimited_identifier ::= SQL_IDENT_DELIMITED
